import java.util.Arrays;
import java.util.Random;
import java.util.Scanner;

public class Main {

    static void bubbleSort(int[] arr) {
        int i = 0;

        while (i < arr.length - 1) {
            int j = 0;

            while (j < arr.length - i - 1) {
                if (arr[j] > arr[j + 1]) {
                    int temp = arr[j];
                    arr[j] = arr[j + 1];
                    arr[j + 1] = temp;
                }
                j++;
            }
            i++;
        }
    }

    static void selectionSort(int[] arr) {
        int i = 0;

        while (i < arr.length - 1) {
            int min = i;
            int j = i + 1;

            while (j < arr.length) {
                if (arr[j] < arr[min])
                    min = j;
                j++;
            }

            int temp = arr[i];
            arr[i] = arr[min];
            arr[min] = temp;

            i++;
        }
    }

    static void insertionSort(int[] arr) {
        int i = 1;

        while (i < arr.length) {
            int key = arr[i];
            int j = i - 1;

            while (j >= 0 && arr[j] > key) {
                arr[j + 1] = arr[j];
                j--;
            }

            arr[j + 1] = key;
            i++;
        }
    }

    static void quickSort(int[] arr, int low, int high) {
        if (low < high) {
            int pivot = partition(arr, low, high);

            quickSort(arr, low, pivot - 1);
            quickSort(arr, pivot + 1, high);
        }
    }

    static int partition(int[] arr, int low, int high) {
        int pivot = arr[high];
        int i = low - 1;
        int j = low;

        while (j < high) {
            if (arr[j] < pivot) {
                i++;

                int temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;
            }
            j++;
        }

        int temp = arr[i + 1];
        arr[i + 1] = arr[high];
        arr[high] = temp;

        return i + 1;
    }

    static void mergeSort(int[] arr, int left, int right) {
        if (left < right) {
            int mid = (left + right) / 2;

            mergeSort(arr, left, mid);
            mergeSort(arr, mid + 1, right);

            merge(arr, left, mid, right);
        }
    }

    static void merge(int[] arr, int left, int mid, int right) {
        int[] temp = new int[right - left + 1];

        int i = left;
        int j = mid + 1;
        int k = 0;

        while (i <= mid && j <= right)
            temp[k++] = arr[i] <= arr[j] ? arr[i++] : arr[j++];

        while (i <= mid)
            temp[k++] = arr[i++];

        while (j <= right)
            temp[k++] = arr[j++];

        i = left;
        k = 0;

        while (i <= right)
            arr[i++] = temp[k++];
    }

   
    static long calculateTime(int[] original, int choice) {

     
        int[] arr = Arrays.copyOf(original, original.length);

        long start = System.nanoTime();

        switch (choice) {
            case 1:
                bubbleSort(arr);
                break;

            case 2:
                selectionSort(arr);
                break;

            case 3:
                insertionSort(arr);
                break;

            case 4:
                quickSort(arr, 0, arr.length - 1);
                break;

            case 5:
                mergeSort(arr, 0, arr.length - 1);
                break;

            default:
                return -1;
        }

        long end = System.nanoTime();

        return end - start;
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

     
        int size = 10000;
        int[] arr = new int[size];

        Random random = new Random();

        for (int i = 0; i < size; i++) {
            arr[i] = random.nextInt(100000);
        }

        System.out.println("Array size: " + size);

        System.out.println("\nSorting algorithms:");
        System.out.println("1. Bubble Sort");
        System.out.println("2. Selection Sort");
        System.out.println("3. Insertion Sort");
        System.out.println("4. Quick Sort");
        System.out.println("5. Merge Sort");

        System.out.println("\nCalculating sorting time...\n");

        String[] names = {
                "Bubble Sort",
                "Selection Sort",
                "Insertion Sort",
                "Quick Sort",
                "Merge Sort"
        };

        long fastestTime = Long.MAX_VALUE;
        String fastestAlgorithm = "";

        for (int choice = 1; choice <= 5; choice++) {

            long time = calculateTime(arr, choice);

            System.out.println(names[choice - 1] + " : "
                    + time + " ns"
                    + " (" + (time / 1_000_000.0) + " ms)");

            if (time < fastestTime) {
                fastestTime = time;
                fastestAlgorithm = names[choice - 1];
            }
        }

        System.out.println("\n--------------------------------");
        System.out.println("Fastest Algorithm: " + fastestAlgorithm);
        System.out.println("Time: " + fastestTime + " ns");
        System.out.println("--------------------------------");

        sc.close();
    }
}
